{
  // VS Code's built-in CSS checker does not know Tailwind's @theme / @custom-variant.
  // The Tailwind CSS IntelliSense extension understands them; this silences the false warnings.
  "css.lint.unknownAtRules": "ignore",
  "files.associations": { "*.css": "tailwindcss" },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true
}
